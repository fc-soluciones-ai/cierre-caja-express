# ---- Base de datos ----
# SQLite local (recomendado para un solo punto de caja):
DATABASE_URL="file:./dev.db"
# PostgreSQL en Supabase (ver docs/SUPABASE.md). Hacen falta las dos:
# la agrupada para la aplicacion y la directa para las migraciones.
# DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://...pooler.supabase.com:5432/postgres"

# ---- Moneda ----
MONEDA="CRC"

# ---- Impresora termica 80mm ----
# Modo: NETWORK (IP) | USB | WINDOWS_SHARE | NONE (solo genera el ticket, no imprime)
IMPRESORA_MODO="NETWORK"
IMPRESORA_HOST="192.168.1.87"
IMPRESORA_PUERTO="9100"
IMPRESORA_ANCHO_CARACTERES="48"

# ---- Operacion ----
# Hora a la que se considera que empieza el dia operativo (turnos que cruzan medianoche)
HORA_CORTE_DIA_OPERATIVO="06:00"

# ---- Respaldos ----
# Carpeta donde se guardan las copias. Ponga aqui una unidad DISTINTA a la
# del sistema: una copia en el mismo disco no protege contra un disco danado.
# Ejemplos: "D:/respaldos-caja" o "//servidor/respaldos"
RESPALDO_DIRECTORIO="./respaldos"
# Dias que se conservan las copias.
RESPALDO_RETENCION_DIAS="30"
# Copias que nunca se borran aunque esten vencidas.
RESPALDO_COPIAS_MINIMAS="10"
