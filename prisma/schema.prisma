// =============================================================================
//  Cierre Caja Express - Esquema de datos
// =============================================================================
//  CONVENCIONES OBLIGATORIAS
//
//  1. DINERO: todos los montos son enteros en la UNIDAD MENOR de la moneda
//     (centimos). CRC tiene exponente ISO 4217 = 2, por lo tanto
//     1.000,00 colones se almacena como 100000. Nunca usar Float/Double:
//     el redondeo binario corrompe arqueos de caja.
//     Ver src/lib/money/money.ts para las conversiones.
//
//  2. NO SE GUARDAN SALDOS ACUMULADOS. El saldo de abonos de un chofer y el
//     total de efectivo en caja son SUMAS derivadas. Guardar el acumulado
//     crearia dos fuentes de verdad que se desincronizan ante una correccion.
//
//  3. Los enums se declaran como String, no como enum de PostgreSQL. Los
//     valores validos viven en src/types/enums.ts y se validan con Zod en la
//     capa de servicio. Agregar un valor nuevo es editar un arreglo, no
//     migrar una base en produccion a la una de la manana.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  /// Conexion agrupada (pgbouncer). Es la que usa la aplicacion: reparte unas
  /// pocas conexiones reales entre muchas peticiones, que es lo que necesita
  /// una app web y lo unico que aguanta un entorno sin servidor fijo.
  url = env("DATABASE_URL")

  /// Conexion de sesion, sin agrupar. Prisma la necesita para las migraciones:
  /// cambiar la estructura de las tablas no funciona a traves del agrupador.
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Personas
// -----------------------------------------------------------------------------

/// Operador de la caja. Toda escritura de dinero queda firmada por un cajero.
model Cajero {
  id        String   @id @default(cuid())
  nombre    String
  pin       String // hash del PIN de 4-6 digitos, nunca el PIN en claro
  rol       String   @default("CAJERO") // CAJERO | SUPERVISOR | ADMIN
  estado    String   @default("ACTIVO") // ACTIVO | INACTIVO
  createdAt DateTime @default(now()) @map("created_at")

  /// Intentos fallidos seguidos. Se reinicia al entrar bien.
  intentosFallidos Int @default(0) @map("intentos_fallidos")

  /// Hasta cuando no se aceptan intentos. Un PIN de cuatro digitos se saca
  /// por fuerza bruta en segundos; lo que lo protege no es su largo sino que
  /// solo se pueda probar unas pocas veces por minuto.
  bloqueadoHasta DateTime? @map("bloqueado_hasta")

  abonos        AbonoEfectivo[]
  cargasExcel   CargaExcel[]
  cierres       CierreChofer[]
  arqueos       ArqueoCaja[]
  eventos       EventoAuditoria[]
  sesiones      Sesion[]
  mantenimiento RegistroMantenimiento[]
  evidencias    Evidencia[]

  @@map("cajeros")
}

/// Sesion abierta de un cajero.
///
/// La cookie lleva un token aleatorio, no el id del cajero. Con el id dentro
/// de la cookie, cualquiera que pudiera escribirla entraria como quien
/// quisiera; el token existe solo aqui, caduca, y se puede revocar sin
/// tocar al cajero.
model Sesion {
  id          String   @id @default(cuid())
  /// SHA-256 del token que viaja en la cookie. Si alguien lee esta tabla no
  /// obtiene sesiones utilizables, igual que con el PIN.
  tokenHash   String   @unique @map("token_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  expiraEn    DateTime @map("expira_en")
  /// Ultima vez que se uso, para poder cerrar sesiones olvidadas.
  ultimoUso   DateTime @default(now()) @map("ultimo_uso")
  dispositivo String?

  /// De quien es la sesion. Exactamente uno de los dos, nunca ambos ni
  /// ninguno: lo comprueba el servicio antes de crearla, y quien la lee
  /// distingue por cual de los dos vino.
  ///
  /// Una sola tabla y no una por cada clase de usuario, para que el bloqueo
  /// por intentos, la caducidad y la revocacion se escriban una sola vez.
  cajeroId String? @map("cajero_id")
  choferId String? @map("chofer_id")

  cajero Cajero? @relation(fields: [cajeroId], references: [id], onDelete: Cascade)
  chofer Chofer? @relation(fields: [choferId], references: [id], onDelete: Cascade)

  @@index([cajeroId])
  @@index([choferId])
  @@index([expiraEn])
  @@map("sesiones")
}

/// Repartidor. idMeseroSoftRestaurant es la llave de cruce con los Excel.
model Chofer {
  id                     String @id @default(cuid())
  idMeseroSoftRestaurant String @unique @map("id_mesero_softrestaurant")
  nombre                 String

  /// Nombre sin acentos y en mayusculas. Sirve para cruzar archivos que no
  /// traen idmesero. Se recalcula en cada escritura, no se edita a mano.
  nombreNormalizado String @map("nombre_normalizado")

  /// Direccion donde el navegador pide la foto, con un sufijo que cambia en
  /// cada reemplazo para que no siga mostrando la anterior desde su cache.
  /// Los bytes viven en foto_chofer, no aqui. Ver FotoChofer.
  fotoUrl String? @map("foto_url")

  telefono  String?
  estado    String   @default("ACTIVO") // ACTIVO | INACTIVO
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Entrada a su propia pantalla ----------------------------------------
  //
  // Opcional: un repartidor sin PIN sencillamente no entra, que es el estado
  // de todos hasta que alguien le ponga uno. Lo que ve cuando entra es solo
  // lo suyo; no puede recibir dinero ni cerrar turnos.

  /// Hash scrypt del PIN, nunca el PIN. Null si todavia no se le dio acceso.
  pin String?

  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta")

  turnos       TurnoChofer[]
  sesiones     Sesion[]
  ventasExcel  VentaChoferExcel[]
  asignaciones AsignacionMoto[]
  foto         FotoChofer?

  @@index([nombreNormalizado])
  @@index([estado])
  @@map("choferes")
}

/// La foto de un repartidor.
///
/// EN TABLA APARTE, NO EN UNA COLUMNA DE choferes
///
/// El tablero y la grilla listan repartidores a cada rato. Con los bytes en la
/// misma fila, cada una de esas consultas arrastraria las fotos de todos sin
/// que nadie las pidiera. Aqui hay que ir a buscarlas a proposito.
///
/// EN LA BASE Y NO EN UN ARCHIVO
///
/// Antes se escribian en public/, que servia cuando esto corria en un solo
/// punto de caja con su disco. En Vercel ese disco es de solo lectura y lo que
/// se escriba desaparece en el siguiente despliegue.
model FotoChofer {
  choferId String @id @map("chofer_id")
  chofer   Chofer @relation(fields: [choferId], references: [id], onDelete: Cascade)

  contenido Bytes
  tipoMime  String @map("tipo_mime")

  actualizadaEn DateTime @default(now()) @map("actualizada_en")

  @@map("fotos_chofer")
}

// -----------------------------------------------------------------------------
// Operacion del turno
// -----------------------------------------------------------------------------

/// Un turno por chofer por jornada. Los abonos y el cierre cuelgan de aqui.
model TurnoChofer {
  id            String    @id @default(cuid())
  choferId      String    @map("chofer_id")
  fechaApertura DateTime  @default(now()) @map("fecha_apertura")
  fechaCierre   DateTime? @map("fecha_cierre")
  estado        String    @default("ABIERTO") // ABIERTO | CERRADO

  /// Candado de integridad: vale choferId mientras el turno esta ABIERTO y
  /// NULL cuando se cierra. Como los NULL no colisionan en un indice unico,
  /// la base de datos garantiza un solo turno abierto por chofer, aunque dos
  /// cajas toquen al mismo chofer en el mismo instante.
  candadoTurnoAbierto String? @unique @map("candado_turno_abierto")

  chofer Chofer          @relation(fields: [choferId], references: [id], onDelete: Restrict)
  abonos AbonoEfectivo[]
  cierre CierreChofer?

  @@index([choferId, estado])
  @@index([fechaApertura])
  @@map("turnos_chofer")
}

/// Entrega parcial de efectivo del chofer a la caja durante el turno.
model AbonoEfectivo {
  id            String @id @default(cuid())
  turnoChoferId String @map("turno_chofer_id")

  /// Centimos. Positivo en un abono normal; NEGATIVO en la fila de reverso
  /// que anula a otra. Asi el saldo del chofer sigue siendo un SUM simple y
  /// nunca hay que editar ni borrar una fila de dinero.
  montoAbonado Int      @map("monto_abonado")
  timestamp    DateTime @default(now())
  cajeroId     String   @map("cajero_id")
  dispositivo  String? // punto de caja que registro el abono
  nota         String?

  /// Llave de idempotencia generada por el cliente con crypto.randomUUID().
  /// En una pantalla tactil el doble toque es constante: sin esta llave, dos
  /// envios del mismo abono crean dos movimientos de dinero distintos.
  claveIdempotencia String? @unique @map("clave_idempotencia")

  anuladoPorId String?        @unique @map("anulado_por_id")
  anuladoPor   AbonoEfectivo? @relation("AnulacionAbono", fields: [anuladoPorId], references: [id])
  anula        AbonoEfectivo? @relation("AnulacionAbono")

  turno    TurnoChofer @relation(fields: [turnoChoferId], references: [id], onDelete: Restrict)
  cajero   Cajero      @relation(fields: [cajeroId], references: [id], onDelete: Restrict)
  tiquetes Tiquete[]

  @@index([turnoChoferId])
  @@index([timestamp])
  @@map("abonos_efectivo")
}

// -----------------------------------------------------------------------------
// Ingesta de reportes de Soft Restaurant
// -----------------------------------------------------------------------------

/// Un archivo Excel importado. hashArchivo (SHA-256 del binario) es unico para
/// que el mismo archivo no se pueda cargar dos veces por error.
model CargaExcel {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  tipoCorte        String   @map("tipo_corte") // PARCIAL | TOTAL
  tipoReporte      String   @map("tipo_reporte") // BLANCO | NEGRO
  formatoDetectado String   @map("formato_detectado") // DETALLADO | CONSOLIDADO
  hashArchivo      String   @unique @map("hash_archivo")
  nombreArchivo    String   @map("nombre_archivo")
  cajeroId         String   @map("cajero_id")

  /// Dia operativo (yyyy-mm-dd) al que se imputa el archivo, para consolidar
  /// turnos que cruzan la medianoche.
  diaOperativo   String @map("dia_operativo")
  filasLeidas    Int    @map("filas_leidas")
  filasIgnoradas Int    @map("filas_ignoradas")

  cajero  Cajero             @relation(fields: [cajeroId], references: [id], onDelete: Restrict)
  ventas  VentaChoferExcel[]
  cierres CierreChofer[]

  @@index([diaOperativo])
  @@index([timestamp])
  @@map("cargas_excel")
}

/// Totales por chofer extraidos de UNA carga. Es el detalle normalizado que
/// permite consolidar Blanco + Negro + cortes parciales sin releer archivos.
model VentaChoferExcel {
  id           String @id @default(cuid())
  cargaExcelId String @map("carga_excel_id")

  /// Null si el Excel trae un mesero que aun no existe como chofer. Queda
  /// pendiente de vincular y visible en la pantalla de carga.
  choferId      String? @map("chofer_id")
  idMeseroExcel String  @map("id_mesero_excel")
  nombreExcel   String  @map("nombre_excel")

  efectivo     Int // centimos
  tarjeta      Int // centimos
  sinpe        Int // centimos, columna "otros" del reporte
  importeTotal Int @map("importe_total") // centimos
  viajes       Int // numcheque contados (detallado) o nopersonas (consolidado)

  carga  CargaExcel @relation(fields: [cargaExcelId], references: [id], onDelete: Cascade)
  chofer Chofer?    @relation(fields: [choferId], references: [id], onDelete: SetNull)

  @@unique([cargaExcelId, idMeseroExcel])
  @@index([choferId])
  @@map("ventas_chofer_excel")
}

// -----------------------------------------------------------------------------
// Cierre y conciliacion
// -----------------------------------------------------------------------------

/// Conciliacion final de un turno contra el Excel. Registro inmutable.
model CierreChofer {
  id            String @id @default(cuid())
  turnoChoferId String @unique @map("turno_chofer_id")

  /// Carga principal usada. Si se consolidaron varias, las demas quedan en
  /// cargasConsolidadas (JSON con los ids) para reconstruir el calculo.
  ///
  /// Es NULA en un cierre forzado sin Excel: a veces hay que liquidar a un
  /// repartidor antes de que el reporte del POS este disponible, y negar ese
  /// caso solo lograria que el cierre se hiciera fuera del sistema.
  cargaExcelId       String? @map("carga_excel_id")
  cargasConsolidadas String  @default("[]") @map("cargas_consolidadas")

  // --- Esperado segun Excel (snapshot en centimos al momento del cierre) ---
  efectivoEsperado Int @map("efectivo_esperado")
  tarjetaEsperada  Int @map("tarjeta_esperada")
  sinpeEsperado    Int @map("sinpe_esperado")
  viajesTotales    Int @map("viajes_totales")

  // --- Recibido en caja (centimos) ---
  /// Suma de abonos parciales del turno, congelada al cerrar.
  abonosParciales Int @map("abonos_parciales")

  /// Efectivo entregado en el acto del cierre.
  efectivoEntregado Int @map("efectivo_entregado")

  /// (abonosParciales + efectivoEntregado) - efectivoEsperado
  /// Positivo = SOBRANTE, negativo = FALTANTE.
  diferencia Int

  timestampCierre DateTime @default(now()) @map("timestamp_cierre")
  cajeroId        String   @map("cajero_id")
  arqueoCajaId    String?  @map("arqueo_caja_id")
  observacion     String?

  turno    TurnoChofer @relation(fields: [turnoChoferId], references: [id], onDelete: Restrict)
  carga    CargaExcel? @relation(fields: [cargaExcelId], references: [id], onDelete: Restrict)
  cajero   Cajero      @relation(fields: [cajeroId], references: [id], onDelete: Restrict)
  arqueo   ArqueoCaja? @relation(fields: [arqueoCajaId], references: [id])
  tiquetes Tiquete[]

  @@index([timestampCierre])
  @@index([cajeroId])
  @@map("cierres_chofer")
}

/// Conteo fisico de la caja. Se pide antes de confirmar un cierre grupal.
model ArqueoCaja {
  id       String @id @default(cuid())
  cajeroId String @map("cajero_id")

  /// Lo que el sistema dice que deberia haber (centimos).
  efectivoTeoricoCaja Int @map("efectivo_teorico_caja")

  /// Lo que el cajero conto a mano (centimos).
  efectivoRealContado Int @map("efectivo_real_contado")

  /// real - teorico. Positivo = SOBRANTE, negativo = FALTANTE.
  diferenciaCaja         Int      @map("diferencia_caja")
  desgloseDenominaciones String?  @map("desglose_denominaciones") // JSON opcional
  observacion            String?
  timestamp              DateTime @default(now())

  /// Misma proteccion contra doble toque que en los abonos.
  claveIdempotencia String? @unique @map("clave_idempotencia")

  cajero   Cajero         @relation(fields: [cajeroId], references: [id], onDelete: Restrict)
  cierres  CierreChofer[]
  tiquetes Tiquete[]

  @@index([timestamp])
  @@map("arqueos_caja")
}

// -----------------------------------------------------------------------------
// Impresion y auditoria
// -----------------------------------------------------------------------------

/// Documento del tiquete ya congelado, en JSON (ver src/lib/print/documento.ts).
/// Se guarda el documento y no los bytes ESC/POS para poder previsualizarlo en
/// pantalla, y no los datos de origen para que una reimpresion salga identica
/// al original aunque la plantilla cambie despues.
model Tiquete {
  id              String   @id @default(cuid())
  tipo            String // ABONO | CIERRE_CHOFER | ARQUEO | CIERRE_GRUPAL
  contenidoTexto  String   @map("contenido_texto")
  estadoImpresion String   @default("PENDIENTE") @map("estado_impresion") // PENDIENTE | IMPRESO | ERROR
  intentos        Int      @default(0)
  ultimoError     String?  @map("ultimo_error")
  copias          Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  abonoId        String? @map("abono_id")
  cierreChoferId String? @map("cierre_chofer_id")
  arqueoCajaId   String? @map("arqueo_caja_id")

  abono  AbonoEfectivo? @relation(fields: [abonoId], references: [id], onDelete: Cascade)
  cierre CierreChofer?  @relation(fields: [cierreChoferId], references: [id], onDelete: Cascade)
  arqueo ArqueoCaja?    @relation(fields: [arqueoCajaId], references: [id], onDelete: Cascade)

  @@index([tipo, createdAt])
  @@index([estadoImpresion])
  @@map("tiquetes")
}

/// Bitacora append-only. Nunca se actualiza ni se borra: es la fuente de la
/// pantalla de Historial y Auditoria.
model EventoAuditoria {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  tipo        String // ABONO | ABONO_ANULADO | CARGA_EXCEL | CIERRE_CHOFER | ARQUEO | CHOFER_CREADO | CHOFER_EDITADO | CHOFER_DESACTIVADO | TURNO_ABIERTO | TURNO_CANCELADO | REIMPRESION | LOGIN | LOGIN_FALLIDO | CAJERO_BLOQUEADO | PIN_CAMBIADO | RESPALDO | MOTO_CREADA | MOTO_EDITADA | MOTO_ESTADO | MOTO_ASIGNADA | MOTO_LIBERADA | MANTENIMIENTO | EVIDENCIA
  cajeroId    String?  @map("cajero_id")
  choferId    String?  @map("chofer_id")
  entidadTipo String?  @map("entidad_tipo")
  entidadId   String?  @map("entidad_id")

  /// Monto involucrado en centimos, si aplica. Evita joins en reporteria.
  monto Int?

  /// Detalle en JSON. Nunca debe contener PIN, hash ni datos sensibles.
  detalle     String?
  dispositivo String?

  cajero Cajero? @relation(fields: [cajeroId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([tipo, timestamp])
  @@index([choferId, timestamp])
  @@map("eventos_auditoria")
}

// -----------------------------------------------------------------------------
// Flota de motocicletas
// -----------------------------------------------------------------------------

/// Motocicleta de la flota.
///
/// La placa es la llave primaria porque es el identificador que usa el negocio:
/// aparece en la factura del taller, en el recibo de la gasolinera y en el
/// seguro. Un id interno obligaria a traducir en cada conversacion con el
/// mecanico.
model Motocicleta {
  /// Normalizada en mayusculas y sin espacios. Ver normalizarPlaca().
  placa  String @id
  marca  String
  modelo String
  anio   Int

  /// Kilometraje en KILOMETROS ENTEROS, no decimales.
  ///
  /// Un odometro muestra kilometros enteros y nadie registra fracciones. Con
  /// decimales, el costo por kilometro heredaria el error de redondeo binario
  /// que en este sistema ya se evito para el dinero.
  kilometrajeActual Int @map("kilometraje_actual")

  /// La moto de respaldo, sin chofer fijo. Entra cuando otra cae al taller.
  esComodin Boolean @default(false) @map("es_comodin")

  estado  String  @default("OPERATIVA") // OPERATIVA | EN_MANTENIMIENTO | FUERA_DE_SERVICIO
  fotoUrl String? @map("foto_url")
  notas   String?

  // --- Ficha tecnica -------------------------------------------------------
  //
  // Todo opcional: una moto se da de alta con la placa y el odometro, y la
  // ficha se llena despues, cuando alguien va al taller y anota las medidas.
  // Obligarla de entrada haria que nadie registrara ninguna moto.
  //
  // Las medidas son texto y no numeros a proposito: "2.75-18", "90/90-18" y
  // "428H - 120 L" son designaciones, no cantidades. No se suman ni se
  // comparan, se leen en el mostrador del repuesto.

  /// Ej: "10W-40 Semi-sintetico".
  tipoAceite String? @map("tipo_aceite")

  /// Cada cuantos kilometros toca el aceite EN ESTA moto. Sin valor se usa el
  /// intervalo general. Una moto vieja o de mucha carga puede pedir menos.
  intervaloAceiteKm Int? @map("intervalo_aceite_km")

  medidaLlantaDelantera String? @map("medida_llanta_delantera")
  medidaLlantaTrasera   String? @map("medida_llanta_trasera")

  /// Ej: "28/32", delantera y trasera.
  presionLlantasPsi String? @map("presion_llantas_psi")

  frenoDelantero String? @map("freno_delantero") // Disco | Tambor
  frenoTrasero   String? @map("freno_trasero") // Disco | Tambor

  /// Paso y cantidad de eslabones. Ej: "428H - 120 L".
  medidaCadena String? @map("medida_cadena")

  /// Revision tecnica vehicular. Vencida, la moto no puede circular.
  vencimientoRtv DateTime? @map("vencimiento_rtv")

  /// Marchamo y seguro obligatorio.
  vencimientoSeguro DateTime? @map("vencimiento_seguro")

  // --- Rastreo satelital ---------------------------------------------------

  tieneGps Boolean @default(false) @map("tiene_gps")

  /// Empresa que presta el rastreo.
  gpsProveedor String? @map("gps_proveedor")

  /// IMEI del equipo: los quince digitos que lo identifican ante la red.
  gpsIdentificador String? @map("gps_identificador")

  /// Correo de la cuenta donde el equipo reporta. Es con lo que se entra a la
  /// plataforma del proveedor a ver donde anda la moto.
  gpsCorreo String? @map("gps_correo")

  gpsNotas String? @map("gps_notas")

  /// Ultima vez que alguien comprobo que el equipo estaba conectado y con
  /// corriente. Se pone sola al subir una foto de evidencia.
  gpsRevisadoEn DateTime? @map("gps_revisado_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asignaciones  AsignacionMoto[]
  mantenimiento RegistroMantenimiento[]

  @@index([estado])
  @@index([esComodin])
  @@map("motocicletas")
}

/// Evidencia fotografica de cualquier registro del sistema.
///
/// POR QUE UNA SOLA TABLA Y NO UNA POR CADA COSA
///
/// Empezo siendo solo del GPS. Despues hizo falta para el cambio de llantas,
/// para el alta de una moto, para cada modificacion. Repetir la tabla por cada
/// caso habria multiplicado el mismo codigo de validacion, la misma ruta que
/// la sirve y el mismo tope de tamano, con tres oportunidades de que uno se
/// quedara atras.
///
/// Se apunta a la entidad por tipo e identificador, igual que eventos_auditoria.
/// No hay llave foranea porque el destino cambia segun el tipo; a cambio, el
/// borrado de la entidad tiene que llevarse su evidencia a mano.
///
/// POR QUE LA IMAGEN VIVE EN LA BASE
///
/// Las fotos se escribian en public/, que servia cuando esto corria en un solo
/// punto de caja con su disco. En Vercel ese disco es de solo lectura y lo que
/// se escriba desaparece en el siguiente despliegue. Una evidencia que
/// desaparece no es una evidencia.
///
/// A cambio hay que cuidarles el tamano. El navegador las encoge antes de
/// subirlas (ver lib/imagen.ts) y el servicio limita cuantas guarda por
/// registro (ver services/evidencia.ts).
model Evidencia {
  id String @id @default(cuid())

  /// MOTOCICLETA | GASTO | GPS. Ver TIPOS_DE_ENTIDAD en services/evidencia.ts.
  entidadTipo String @map("entidad_tipo")

  /// La placa, el id del gasto, o la placa otra vez cuando es del GPS.
  entidadId String @map("entidad_id")

  /// Que muestra la foto. Los valores dependen del tipo de entidad.
  tipo String

  /// Bytes de la imagen. El formato se decide por los bytes, no por lo que
  /// declare el navegador.
  contenido Bytes
  tipoMime  String @map("tipo_mime")

  /// Lo que el cajero anoto al subirla: "detras del faro", "llanta trasera".
  descripcion String?

  tomadaEn DateTime @default(now()) @map("tomada_en")
  cajeroId String   @map("cajero_id")
  cajero   Cajero   @relation(fields: [cajeroId], references: [id])

  @@index([entidadTipo, entidadId, tomadaEn])
  @@map("evidencias")
}

/// Quien anduvo en cual moto y desde cuando.
///
/// No se guarda un simple "chofer asignado" en la moto porque eso pierde la
/// historia: el dia que hay que saber quien manejaba la moto que se accidento
/// el martes, o cuantos kilometros hizo cada quien, un solo campo ya fue
/// sobrescrito. La asignacion vigente es la que no tiene fecha de fin.
model AsignacionMoto {
  id       String @id @default(cuid())
  placa    String
  choferId String @map("chofer_id")
  tipo     String @default("FIJA") // FIJA | COMODIN

  fechaInicio DateTime  @default(now()) @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  motivo      String?

  /// Candados de integridad, con la misma tecnica que los turnos: valen
  /// mientras la asignacion esta vigente y NULL cuando termina. Como los NULL
  /// no colisionan en un indice unico, la base garantiza por si sola que un
  /// chofer no tenga dos motos ni una moto dos choferes.
  candadoChoferActivo String? @unique @map("candado_chofer_activo")
  candadoMotoActiva   String? @unique @map("candado_moto_activa")

  moto   Motocicleta @relation(fields: [placa], references: [placa], onDelete: Restrict)
  chofer Chofer      @relation(fields: [choferId], references: [id], onDelete: Restrict)

  @@index([choferId, fechaInicio])
  @@index([placa, fechaInicio])
  @@map("asignaciones_moto")
}

/// Gasto o servicio hecho a una moto: gasolina, taller, repuestos, seguro.
///
/// Es la fuente del costo por kilometro y del historial por placa. Como todo
/// movimiento de dinero en este sistema, el costo va en centimos enteros.
model RegistroMantenimiento {
  id    String @id @default(cuid())
  placa String

  tipo      String // PREVENTIVO | CORRECTIVO
  categoria String // GASOLINA | CAMBIO_ACEITE | LLANTAS | FRENOS | REPUESTOS | RTV | SEGURO | OTRO

  descripcion String?

  /// Centimos. Cero es valido: una revision en garantia no cuesta nada.
  costoTotal Int @map("costo_total")

  /// Kilometraje del odometro en el momento del evento, en kilometros enteros.
  kilometrajeEvento Int @map("kilometraje_evento")

  tallerOProveedor String? @map("taller_o_proveedor")
  comprobanteUrl   String? @map("comprobante_url")

  timestamp DateTime @default(now())
  cajeroId  String   @map("cajero_id")

  /// Misma proteccion contra doble toque que en los abonos.
  claveIdempotencia String? @unique @map("clave_idempotencia")

  moto   Motocicleta @relation(fields: [placa], references: [placa], onDelete: Restrict)
  cajero Cajero      @relation(fields: [cajeroId], references: [id], onDelete: Restrict)

  @@index([placa, timestamp])
  @@index([categoria, timestamp])
  @@index([timestamp])
  @@map("registros_mantenimiento")
}
